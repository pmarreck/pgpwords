local even_by_hex = {}
local odd_by_hex = {}
local even_to_hex = {}
local odd_to_hex = {}

for _, row in ipairs(WORDS) do
	even_by_hex[row[1]] = row[2]
	odd_by_hex[row[1]] = row[3]
	even_to_hex[string.lower(row[2])] = row[1]
	odd_to_hex[string.lower(row[3])] = row[1]
end

local function usage()
	return "Usage: pgpwords [OPTIONS] [--] [INPUT]"
end

local function help()
	return table.concat({
		usage(),
		"",
		"Translate hexadecimal bytes to and from the PGP word list.",
		"",
		"Options:",
		"  -e, --encode        Treat input as hexadecimal and output PGP words",
		"  -d, --decode        Treat input as PGP words and output hexadecimal",
		"      --endian=MODE   Extension mode: none, auto for decode, big for encode",
		"  -h, --help          Show this help",
		"      --about         Show one-line program information",
		"      --lang CODE     Accept language override; English is currently implemented",
		"",
		"Endian extension:",
		"  Default behavior is the stock PGP wordlist byte-stream encoding: no endian marker is emitted or interpreted.",
		"  The opt-in endian extension makes byte-order intent explicit for fingerprints and binary values where endian confusion is a real failure mode.",
		"  --endian=big is valid with --encode and prefixes byte BE before the already-big-endian input bytes.",
		"  --endian=auto is valid with --decode and strips an explicit BE marker from decoded bytes.",
		"  The marker is width-agnostic metadata only: pgpwords does not reorder bytes or infer 16-bit, 32-bit, 64-bit, or larger value width.",
		"  Literal data that collides with the marker may be escaped as (00 00)^n BE followed by the original colliding payload.",
		"  Example: --encode --endian=big E582 emits words for BE E5 82, shifting payload parity by one word.",
		"",
		"Streaming:",
		"  Explicit stdin modes stream complete units: --encode emits words per byte, --decode emits hex per word.",
		"  Stdin auto-detection without --encode or --decode buffers input so the mode can be inferred.",
		"",
		"Input may be passed as arguments, '-' or '@stdin', or via stdin when no input is given.",
	}, "\n")
end

local function die(message)
	io.stderr:write("pgpwords: " .. message .. "\n")
	os.exit(1)
end

local function read_stdin()
	local chunks = {}
	while true do
		local chunk = io.read(8192)
		if chunk == nil then break end
		chunks[#chunks + 1] = chunk
	end
	return table.concat(chunks)
end

local function normalize_hex(input)
	local without_prefixes = input:gsub("0[xX]", "")
	local compact = without_prefixes:gsub("[%s:%-_]", "")
	if compact:find("[^0-9A-Fa-f]") then
		die("hex input contains non-hex character")
	end
	if #compact % 2 ~= 0 then
		die("hex input must contain an even number of digits")
	end
	return string.upper(compact)
end

local function encode(input, endian)
	local compact = normalize_hex(input)
	if endian == "big" then
		compact = "BE" .. compact
	end
	local out = {}
	local pos = 0
	for i = 1, #compact, 2 do
		local byte = compact:sub(i, i + 1)
		if pos % 2 == 0 then
			out[#out + 1] = even_by_hex[byte]
		else
			out[#out + 1] = odd_by_hex[byte]
		end
		pos = pos + 1
	end
	return table.concat(out, " ")
end

local function emit_word(word, state)
	if not state.first then
		io.stdout:write(" ")
	end
	io.stdout:write(word)
	io.stdout:flush()
	state.first = false
end

local function stream_encode(endian)
	local state = { first = true, pos = 0, nibble = nil, pending_zero = false }

	local function emit_byte(byte)
		if state.pos % 2 == 0 then
			emit_word(even_by_hex[byte], state)
		else
			emit_word(odd_by_hex[byte], state)
		end
		state.pos = state.pos + 1
	end

	local function process_hex_char(c)
		if c:match("[%s:%-_]") then
			return
		end
		if not c:match("[0-9A-Fa-f]") then
			die("hex input contains non-hex character")
		end
		c = string.upper(c)
		if state.nibble == nil then
			state.nibble = c
		else
			emit_byte(state.nibble .. c)
			state.nibble = nil
		end
	end

	local function process_char(c)
		if state.pending_zero then
			if c == "x" or c == "X" then
				state.pending_zero = false
				return
			end
			state.pending_zero = false
			process_hex_char("0")
		end
		if c == "0" then
			state.pending_zero = true
		else
			process_hex_char(c)
		end
	end

	if endian == "big" then
		emit_byte("BE")
	end

	while true do
		local c = io.stdin:read(1)
		if c == nil then break end
		process_char(c)
	end
	if state.pending_zero then
		process_hex_char("0")
	end
	if state.nibble ~= nil then
		die("hex input must contain an even number of digits")
	end
	io.stdout:write("\n")
end

local function starts_with(value, prefix)
	return value:sub(1, #prefix) == prefix
end

local function decode_endian_extension(hex)
	if starts_with(hex, "BE") then
		return hex:sub(3)
	end

	local zero_pairs = 0
	local offset = 1
	while hex:sub(offset, offset + 3) == "0000" do
		zero_pairs = zero_pairs + 1
		offset = offset + 4
	end

	if zero_pairs > 0 and hex:sub(offset, offset + 1) == "BE" then
		local escaped_payload = hex:sub(offset + 2)
		local expected_payload_prefix = string.rep("0000", zero_pairs - 1) .. "BE"
		if not starts_with(escaped_payload, expected_payload_prefix) then
			die("malformed endian escape prefix")
		end
		return escaped_payload
	end

	return hex
end

local function decode(input)
	local out = {}
	local pos = 0
	local saw_word = false
	for word in input:gmatch("%S+") do
		saw_word = true
		local lower = string.lower(word)
		if pos % 2 == 0 then
			if even_to_hex[lower] then
				out[#out + 1] = even_to_hex[lower]
			elseif odd_to_hex[lower] then
				die("word at position " .. pos .. " belongs to the odd list, expected even: " .. word)
			else
				die("unknown PGP word at position " .. pos .. ": " .. word)
			end
		else
			if odd_to_hex[lower] then
				out[#out + 1] = odd_to_hex[lower]
			elseif even_to_hex[lower] then
				die("word at position " .. pos .. " belongs to the even list, expected odd: " .. word)
			else
				die("unknown PGP word at position " .. pos .. ": " .. word)
			end
		end
		pos = pos + 1
	end
	if not saw_word then
		die("word input is empty")
	end
	return table.concat(out)
end

local function decode_word(word, pos)
	local lower = string.lower(word)
	if pos % 2 == 0 then
		if even_to_hex[lower] then
			return even_to_hex[lower]
		elseif odd_to_hex[lower] then
			die("word at position " .. pos .. " belongs to the odd list, expected even: " .. word)
		else
			die("unknown PGP word at position " .. pos .. ": " .. word)
		end
	else
		if odd_to_hex[lower] then
			return odd_to_hex[lower]
		elseif even_to_hex[lower] then
			die("word at position " .. pos .. " belongs to the even list, expected odd: " .. word)
		else
			die("unknown PGP word at position " .. pos .. ": " .. word)
		end
	end
end

local function make_hex_stream_writer(endian)
	local resolved = endian ~= "auto"
	local pending = {}

	local function raw_emit(hex)
		io.stdout:write(hex)
		io.stdout:flush()
	end

	local function flush_pending_as_data()
		for _, byte in ipairs(pending) do
			raw_emit(byte)
		end
		pending = {}
		resolved = true
	end

	local function try_resolve_pending()
		if #pending == 0 then
			return
		end
		if pending[1] == "BE" then
			pending = {}
			resolved = true
			return
		end
		if pending[1] ~= "00" then
			flush_pending_as_data()
			return
		end
		if #pending == 1 then
			return
		end

		local zero_pairs = 0
		local idx = 1
		while pending[idx] == "00" and pending[idx + 1] == "00" do
			zero_pairs = zero_pairs + 1
			idx = idx + 2
		end

		if zero_pairs == 0 then
			flush_pending_as_data()
			return
		end
		if idx > #pending then
			return
		end
		if pending[idx] ~= "BE" then
			flush_pending_as_data()
			return
		end

		local expected = {}
		for _ = 1, zero_pairs - 1 do
			expected[#expected + 1] = "00"
			expected[#expected + 1] = "00"
		end
		expected[#expected + 1] = "BE"

		local available = #pending - idx
		if available < #expected then
			return
		end
		for i = 1, #expected do
			if pending[idx + i] ~= expected[i] then
				die("malformed endian escape prefix")
			end
		end

		for i = idx + 1, #pending do
			raw_emit(pending[i])
		end
		pending = {}
		resolved = true
	end

	return {
		byte = function(hex)
			if resolved then
				raw_emit(hex)
				return
			end
			pending[#pending + 1] = hex
			try_resolve_pending()
		end,
		finish = function()
			if not resolved and #pending > 0 then
				raw_emit(decode_endian_extension(table.concat(pending)))
				pending = {}
				resolved = true
			end
			io.stdout:write("\n")
		end,
	}
end

local function stream_decode(endian)
	local writer = make_hex_stream_writer(endian)
	local token = {}
	local pos = 0
	local saw_word = false

	local function flush_token()
		if #token == 0 then
			return
		end
		local word = table.concat(token)
		token = {}
		saw_word = true
		writer.byte(decode_word(word, pos))
		pos = pos + 1
	end

	while true do
		local c = io.stdin:read(1)
		if c == nil then break end
		if c:match("%s") then
			flush_token()
		else
			token[#token + 1] = c
		end
	end
	flush_token()
	if not saw_word then
		die("word input is empty")
	end
	writer.finish()
end

local function looks_like_hex(input)
	local without_prefixes = input:gsub("0[xX]", "")
	local compact = without_prefixes:gsub("[%s:%-_]", "")
	return #compact > 0 and #compact % 2 == 0 and compact:find("[^0-9A-Fa-f]") == nil
end

local function parse_args(argv)
	local mode = nil
	local endian = "none"
	local parts = {}
	local stop_options = false
	local usage_only = false
	local help_requested = false
	local i = 1
	while i <= #argv do
		local arg = argv[i]
		if not stop_options and arg == "--" then
			stop_options = true
		elseif not stop_options and (arg == "-h" or arg == "--help") then
			help_requested = true
		elseif not stop_options and arg == "--usage-only" then
			usage_only = true
		elseif not stop_options and arg == "--about" then
			return { action = "about" }
		elseif not stop_options and (arg == "-e" or arg == "--encode") then
			mode = "encode"
		elseif not stop_options and (arg == "-d" or arg == "--decode") then
			mode = "decode"
		elseif not stop_options and arg == "--endian" then
			i = i + 1
			if i > #argv then
				die("--endian requires a mode")
			end
			endian = argv[i]
		elseif not stop_options and arg:sub(1, 9) == "--endian=" then
			endian = arg:sub(10)
		elseif not stop_options and arg == "--lang" then
			i = i + 1
			if i > #argv then
				die("--lang requires a language code")
			end
		elseif not stop_options and arg:sub(1, 7) == "--lang=" then
		elseif not stop_options and (arg == "--simple" or arg == "--no-ansi" or arg == "--no-color") then
		elseif not stop_options and arg:sub(1, 1) == "-" and arg ~= "-" then
			die("unknown option: " .. arg)
		else
			parts[#parts + 1] = arg
		end
		i = i + 1
	end
	if help_requested then
		return { action = "help", usage_only = usage_only }
	end
	if endian ~= "none" and endian ~= "auto" and endian ~= "big" then
		die("unknown endian mode: " .. endian)
	end
	return { action = "run", mode = mode, endian = endian, input_parts = parts, usage_only = usage_only }
end

local args = {}
for i = 1, #arg do
	args[i] = arg[i]
end

local parsed = parse_args(args)

if parsed.action == "about" then
	print("pgpwords " .. VERSION .. " - translate hexadecimal bytes to and from the PGP word list")
	os.exit(0)
end

if parsed.action == "help" then
	if parsed.usage_only then
		print(usage())
	else
		print(help())
	end
	os.exit(0)
end

local mode = parsed.mode
local use_stdin = #parsed.input_parts == 0
	or (#parsed.input_parts == 1 and (parsed.input_parts[1] == "-" or parsed.input_parts[1] == "@stdin"))

if mode == "encode" and parsed.endian == "auto" then
	die("--endian=auto is only valid when decoding")
end
if mode == "decode" and parsed.endian == "big" then
	die("--endian=big is only valid when encoding")
end

if use_stdin and mode == "encode" then
	stream_encode(parsed.endian)
	os.exit(0)
elseif use_stdin and mode == "decode" then
	stream_decode(parsed.endian)
	os.exit(0)
end

local input
if use_stdin then
	input = read_stdin()
else
	input = table.concat(parsed.input_parts, " ")
end

if mode == nil then
	if looks_like_hex(input) then
		mode = "encode"
	else
		mode = "decode"
	end
end

if mode == "encode" then
	print(encode(input, parsed.endian))
elseif mode == "decode" then
	local hex = decode(input)
	if parsed.endian == "auto" then
		hex = decode_endian_extension(hex)
	end
	print(hex)
else
	die("internal error: unknown mode")
end
