# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
depth=4

annotate=[
	LICENSE = MIT license for pgpwords.
	PLAN.md = Current implementation checklist and checkpoint log.
	README.md = Project overview, CLI examples, endian extension semantics, development commands, and source references.
	bin = Executable LuaJIT CLI entrypoints installed directly onto PATH via this repository.
	bin/pgpwords = LuaJIT PGP wordlist translator; embeds parity tables, CLI parsing, and opt-in endian marker handling.
	build = Top-level build/validation script that syntax-checks and stages the LuaJIT CLI.
	flake.lock = Pinned nixpkgs-unstable lockfile generated by Nix flake tooling.
	flake.nix = Nix dev shell, package, and check definitions for LuaJIT pgpwords plus gh/jj developer tools.
	test = Top-level test runner for the full non-benchmark suite.
	tests = Project test suites and source fixtures.
	tests/cli/pgpwords = Bash CLI regression suite covering public options, stdin, exhaustive wordlist sets, parity errors, and endian extensions.
	tests/fixtures/pgp_wordlist.tsv = Spec fixture table for every PGP even/odd word keyed by byte value.
]
