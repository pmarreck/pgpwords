# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
depth=4

annotate=[
	PLAN.md = Current implementation checklist and checkpoint log.
	bin = Executable LuaJIT CLI entrypoints installed directly onto PATH via this repository.
	bin/pgpwords = LuaJIT PGP wordlist translator; embeds the two 256-word parity tables and CLI parsing.
	build = Top-level build/validation script that syntax-checks and stages the LuaJIT CLI.
	flake.lock = Pinned Nix input lockfile generated by nix flake check.
	flake.nix = Nix dev shell, package, and check definitions for LuaJIT-based pgpwords.
	test = Top-level test runner for the full non-benchmark suite.
	tests = Project test suites and source fixtures.
	tests/cli/pgpwords = Bash CLI regression suite covering public options, stdin, exhaustive wordlist sets, and parity errors.
	tests/fixtures/pgp_wordlist.tsv = Spec fixture table for every PGP even/odd word keyed by byte value.
]
